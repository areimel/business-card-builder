{
  "name": "resume-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "vite build",
    "test": "node --import ./server/jsx-hooks.js --test tests/style-css.test.js tests/style-storage.test.js tests/server-api.test.js tests/theme-components.test.js",
    "test:browser": "node --test tests/style-editor.browser.test.js",
    "dev": "concurrently -n api,web -c blue,magenta \"node --import ./server/jsx-hooks.js --watch-path=./server server/index.js\" \"vite\"",
    "dev:api": "node --import ./server/jsx-hooks.js server/index.js",
    "dev:web": "vite",
    "export": "node --import ./server/jsx-hooks.js server/export-cli.js"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@mdx-js/mdx": "^3.1.1",
    "@uiw/react-codemirror": "^4.25.12",
    "chokidar": "^6.0.0",
    "css-tree": "^3.2.1",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "gray-matter": "^4.0.3",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
